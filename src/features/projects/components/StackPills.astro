---
import {
  TECH_ICON_ONERROR,
  getIconBgClass,
  getIconSources,
  getMonogram,
} from "../../../lib/techIcons";

interface Props {
  stack: string[];
  /**
   * How each entry renders below `sm`. `icons` keeps the unlabelled tile grid
   * (project pages); `pills` puts a small mark beside the name, for the tight
   * cells of the homepage grid where an unlabelled icon is hard to place.
   * From `sm` up both are identical.
   */
  mobileLayout?: "icons" | "pills";
}

const { stack, mobileLayout = "icons" } = Astro.props;
const isPills = mobileLayout === "pills";
---

<div class="flex flex-wrap gap-2">
  {
    stack.map((tech) => {
      const { primary, fallback, fallbackTemplate } = getIconSources(tech);
      const monogram = getMonogram(tech);
      const iconBgClass = getIconBgClass(tech, isPills);

      return (
        <div>
          <div
            class:list={[
              isPills
                ? "flex items-center gap-1.5 rounded-full border border-site-border bg-site-surface-hover px-2.5 py-1 sm:w-20 sm:flex-col sm:gap-2 sm:rounded-none sm:border-0 sm:bg-transparent sm:px-0 sm:py-0 sm:text-center"
                : "flex w-10 flex-col items-center gap-1.5 text-center sm:w-20 sm:gap-2",
            ]}
          >
            <div
              class:list={[
                "relative flex items-center justify-center overflow-hidden sm:h-12 sm:w-12",
                isPills ? "h-4 w-4 shrink-0" : "h-10 w-10",
              ]}
            >
              {primary || fallback ? (
                <img
                  src={primary ?? fallback!}
                  data-fallback-src={fallback ?? ""}
                  data-theme-simple-icon-template={
                    !primary ? (fallbackTemplate ?? undefined) : undefined
                  }
                  alt={`${tech} logo`}
                  title={tech}
                  loading="lazy"
                  class:list={[
                    "relative z-60 object-contain sm:h-12 sm:w-12 sm:rounded-xl sm:border-2 sm:border-site-border",
                    isPills
                      ? "h-4 w-4"
                      : "h-10 w-10 rounded-xl border-2 border-site-border",
                    iconBgClass,
                  ]}
                  onerror={TECH_ICON_ONERROR}
                />
              ) : null}
              <span
                data-icon-fallback
                class:list={[
                  "absolute inset-0 items-center justify-center font-semibold tracking-wide text-site-subtext sm:text-[11px]",
                  isPills ? "text-[9px]" : "text-[11px]",
                  primary || fallback ? "hidden" : "flex",
                ]}
                aria-hidden="true"
              >
                {monogram}
              </span>
            </div>
            <span
              class:list={[
                "text-[11px] leading-tight sm:break-words sm:text-xs sm:text-site-dim",
                isPills
                  ? "whitespace-nowrap text-site-subtext sm:whitespace-normal"
                  : "hidden break-words text-site-dim sm:block",
              ]}
            >
              {tech}
            </span>
          </div>
        </div>
      );
    })
  }
</div>
