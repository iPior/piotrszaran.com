---
import AppLayout from "../../../layouts/AppLayout.astro";
import CategoryBadge from "../components/CategoryBadge.astro";
import StackPills from "../components/StackPills.astro";
import MilestoneBar from "../components/MilestoneBar.astro";
import { formatAgo, isPaused } from "../../../lib/projects";
import BackLink from "../../../components/BackLink.astro";
import { formatDate } from "../../../lib/utils";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  relatedBlog?: CollectionEntry<"blog"> | null;
}

const { project, relatedBlog } = Astro.props;
const { title, description, date, category, stack, liveUrl, githubUrl, depth, status, progress } =
  project.data;
const inProgress = status === "in-progress" && progress !== undefined;
const paused = progress ? isPaused(progress.updated) : false;
---

<AppLayout title={title} description={description}>
  <BackLink href="/projects" label="Back to projects" />
  <article class="mt-5 sm:mt-6">
    <header class="mb-8">
      <div class="mb-3 flex flex-wrap items-center gap-3">
        <CategoryBadge category={category} />
        <time class="text-xs text-site-dim sm:text-sm">{inProgress && "Started "}{formatDate(date)}</time>
        {inProgress && (
          <span class:list={["inline-flex items-center gap-1.5 text-xs", paused ? "text-site-subtext" : "text-site-peach"]}>
            <span class:list={["h-1.5 w-1.5 rounded-full", paused ? "bg-site-overlay" : "bg-site-peach"]} aria-hidden="true"></span>
            {paused ? "Paused" : "In progress"}
          </span>
        )}
        {depth === 'short' && <span class="text-xs text-site-dim">Project notes</span>}
      </div>
      <h1 class="mb-3 text-2xl font-bold text-site-text sm:text-3xl">
        {title}
      </h1>
      <p class="mb-4 text-base text-site-subtext sm:text-lg">{description}</p>
      {inProgress && progress && (
        <div class="mb-5 rounded-lg border border-site-border bg-site-surface p-4">
          <p class="text-sm leading-relaxed text-site-subtext">
            <span class={paused ? "text-site-dim" : "text-site-peach"}>{paused ? "Last:" : "Now:"}</span> {progress.focus}
            <span class="text-site-dim"> · updated {formatAgo(progress.updated)}</span>
          </p>
          <div class="mt-3">
            <MilestoneBar milestones={progress.milestones} paused={paused} showCurrent />
          </div>
        </div>
      )}
      {stack && stack.length > 0 && <StackPills stack={stack} />}
      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1">
        {
          liveUrl && (
            <a
              href={liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-site-blue hover:underline"
            >
              Live ↗
            </a>
          )
        }
        {
          githubUrl && (
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-site-blue hover:underline"
            >
              GitHub ↗
            </a>
          )
        }
      </div>
      {
        relatedBlog && (
          <div class="mt-6 p-4 border border-site-border rounded-lg bg-site-surface">
            <p class="text-xs text-site-dim mb-1 uppercase tracking-wide font-medium">
              Related
            </p>
            <a
              href={`/blogs/${relatedBlog.slug}`}
              class="text-site-blue hover:underline font-medium"
            >
              Read the full write-up →
            </a>
          </div>
        )
      }
    </header>
    {depth === 'full' && <hr class="mb-6 border-site-border sm:mb-8" />}
    <div class="prose max-w-none">
      <slot />
    </div>
    <BackLink href="/projects" label="Back to projects" />
  </article>
</AppLayout>
