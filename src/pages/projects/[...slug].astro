---
import { getCollection } from 'astro:content';
import ProjectLayout from '../../features/projects/layouts/ProjectLayout.astro';
import Callout from '../../components/mdx/Callout.astro';
import Image from '../../components/mdx/Image.astro';
import LinkCard from '../../components/mdx/LinkCard.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.hidden);
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();

const relatedBlogs = (await getCollection('blog', ({ data }) => !data.draft && !data.hidden))
  .filter((post) => post.data.projectSlug === project.slug || post.slug === project.data.blogSlug)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
---

<ProjectLayout project={project} relatedBlogs={relatedBlogs}>
  <Content components={{ Callout, Image, LinkCard }} />
</ProjectLayout>
