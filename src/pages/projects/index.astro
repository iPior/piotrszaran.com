---
import AppLayout from "../../layouts/AppLayout.astro";
import ProjectFilter from "../../features/projects/components/ProjectFilter";
import ProjectPageIntro from "../../features/projects/components/ProjectPageIntro.astro";
import FeaturedProjects from "../../features/projects/components/FeaturedProjects.astro";
import { getCollection } from "astro:content";
import { numberProjects } from "../../lib/projects";

const projects = numberProjects(
  (await getCollection("projects", ({ data }) => !data.hidden)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  ),
);

const filterProjects = projects.map((project) => ({
  id: project.slug,
  itemNumber: project.itemNumber,
  title: project.data.title,
  description: project.data.description,
  category: project.data.category,
  date: project.data.date.toISOString(),
  stack: project.data.stack ?? [],
  liveUrl: project.data.liveUrl,
  githubUrl: project.data.githubUrl,
  depth: project.data.depth,
  inProgress: project.data.status === 'in-progress',
}));
---

<AppLayout
  title="Projects — Piotr Szaran"
  description="selected software projects"
>
  <ProjectPageIntro />

  <FeaturedProjects projects={projects.filter((project) => project.data.featured)} />

  <section class="mt-10" aria-label="All projects">
    {
      projects.length === 0 ? (
        <p class="py-6 text-site-dim">No projects yet.</p>
      ) : (
        <ProjectFilter client:load projects={filterProjects} />
      )
    }
  </section>
</AppLayout>
